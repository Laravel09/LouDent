{
  "name": "loudent",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "test": "vitest run src/",
    "test:db": "node --test db-tests/*.test.mjs",
    "test:e2e": "playwright test",
    "format": "oxfmt"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "embedded-postgres": "^17.5.0-beta.15",
    "oxfmt": "^0.2.0",
    "pg": "^8.13.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.1.1"
  },
  "description": "LouDent dental appointment system - React + Supabase (legacy Express/MariaDB reference kept in ./server)",
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "esbuild@0.28.2": true
  }
}
