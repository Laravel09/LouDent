# Copy to .env, and never commit the .env file.
PORT=3001
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=loudent_app
DB_PASSWORD=CHANGE_THIS_TO_YOUR_DB_PASSWORD
DB_NAME=loudent
# Local HTTP only. Behind production HTTPS, change NODE_ENV to production.
NODE_ENV=development
# Explicit localhost frontend origin if calling API without Vite proxy.
FRONTEND_ORIGIN=http://localhost:5173
# Dentist ids (comma separated) that also act as clinic administrator and may manage appointments
# assigned to ANY dentist. Everyone else with the dentist role manages only their own.
CLINIC_ADMIN_DENTIST_IDS=santos

# Address users open in the browser; emailed links start with this (must be https:// in production)
APP_BASE_URL=http://localhost:5173

# Email for account verification and password reset.
#   preview = DEVELOPMENT ONLY. Nothing is sent; messages appear in the API terminal and a dev panel.
#   smtp    = real delivery through your SMTP provider (fill in the MAIL_SMTP_* values below)
#   none    = send nothing
MAIL_TRANSPORT=preview
MAIL_FROM="LouDent <no-reply@your-domain.example>"
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASS=

# Per-IP request limits for sign-up / password recovery are shared by everyone behind the dev proxy.
# Leave at 1 normally; the automated database tests use a larger value (see .env.test.example).
# AUTH_RATE_LIMIT_IP_SCALE=1
