# LouDent frontend configuration (Vite). Copy to .env.local and fill in.
# These values are PUBLIC by design: they are compiled into the browser bundle.
# NEVER put the Supabase secret key / service_role key in any VITE_ variable.

# Supabase project URL (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://qlsfeqofszmtdkdedkqz.supabase.co

# Supabase PUBLISHABLE key (starts with sb_publishable_). Paste it locally only.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: canonical public URL of the site, used for email-link redirects.
# Leave empty locally (window.location.origin is used). On Vercel set it to
# your production URL, e.g. https://loudent.vercel.app
VITE_SITE_URL=
